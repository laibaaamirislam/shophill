<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Storefront</h1>
  <%= link_to "View Cart", cart_path, class: "btn btn-outline-primary" %>
</div>

<div class="mb-4">
  <strong>Filter by Category:</strong>
  <%= link_to "All", products_path, class: "btn btn-sm btn-outline-secondary ms-2" %>
  <% @categories.each do |cat| %>
    <%= link_to cat.name, products_path(category_id: cat.id), class: "btn btn-sm btn-outline-secondary me-1" %>
  <% end %>
</div>

<div class="row">
  <% @products.each do |product| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <% if product.images.attached? %>
          <%= image_tag product.images.first, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
        <% end %>
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-success font-weight-bold">$<%= "%.2f" % product.price %></p>
          </div>
          <%= link_to "View Details", product_path(product), class: "btn btn-primary btn-sm mt-3" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%= will_paginate @products %>