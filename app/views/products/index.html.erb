<!-- Storefront Header / Banner -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
  <div class="row align-items-center">
    <div class="col-md-7">
      <span class="badge bg-dark-subtle text-dark mb-2 px-3 py-2 rounded-pill fw-bold">#ShophillStore</span>
      <h1 class="display-5 fw-bold text-dark mb-3">Explore Our Catalog</h1>
      <p class="text-secondary mb-4">Quality products curated for you with fast delivery and easy returns.</p>
    </div>
  </div>
</div>

<!-- Dynamic Categories Filter -->
<div class="d-flex justify-content-center flex-wrap gap-4 mb-5 text-center">
  <div>
    <%= link_to products_path(query: params[:query]), 
                class: "d-inline-flex align-items-center justify-content-center rounded-circle border shadow-sm text-decoration-none #{params[:category_id].blank? ? 'bg-dark text-white' : 'bg-white text-dark'}", 
                style: "width: 64px; height: 64px;" do %>
      <span class="fw-bold">All</span>
    <% end %>
    <small class="fw-bold d-block mt-2 text-dark">All</small>
  </div>

  <% @categories.each do |category| %>
    <div>
      <%= link_to products_path(category_id: category.id, query: params[:query]), 
                  class: "d-inline-flex align-items-center justify-content-center rounded-circle border shadow-sm text-decoration-none #{params[:category_id].to_s == category.id.to_s ? 'bg-dark text-white' : 'bg-white text-dark'}", 
                  style: "width: 64px; height: 64px;" do %>
        <span class="fw-bold"><%= category.name.first.upcase %></span>
      <% end %>
      <small class="fw-bold d-block mt-2 text-dark"><%= category.name %></small>
    </div>
  <% end %>
</div>

<!-- Products Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
  <% @products.each do |product| %>
    <% 
      # Calculate current quantity of this product already in cart
      cart_item = Current.customer&.cart&.cart_items&.find { |ci| ci.product_id == product.id }
      qty_in_cart = cart_item&.quantity || 0
      max_reached = qty_in_cart >= product.stock_quantity.to_i
    %>
    <div class="col">
      <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column justify-content-between">
        
        <!-- Clickable Area (Links to Product Details) -->
        <%= link_to product_path(product), class: "text-decoration-none text-dark d-block" do %>
          <div>
            <!-- Product Image -->
            <div class="bg-light rounded-3 m-2 d-flex align-items-center justify-content-center position-relative overflow-hidden" style="height: 180px;">
              <% if product.respond_to?(:images) && product.images.attached? %>
                <%= image_tag product.images.first, class: "w-100 h-100 object-fit-cover" %>
              <% else %>
                <span class="text-muted small">No Image</span>
              <% end %>

              <!-- Stock Badges -->
              <% if product.stock_quantity.to_i <= 0 %>
                <span class="badge bg-secondary position-absolute top-0 start-0 m-2">Out of Stock</span>
              <% elsif max_reached %>
                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Max in Cart</span>
              <% elsif product.stock_quantity.to_i <= 5 %>
                <span class="badge bg-danger position-absolute top-0 start-0 m-2">Low Stock</span>
              <% end %>
            </div>

            <!-- Product Details -->
            <div class="p-3">
              <h6 class="fw-bold text-dark mb-1 text-truncate"><%= product.name %></h6>
              <div class="text-muted small"><%= product.category&.name || "Uncategorized" %></div>
            </div>
          </div>
        <% end %>

        <!-- Pricing & Add Button -->
        <div class="p-3 pt-0 d-flex align-items-center justify-content-between">
          <span class="fw-bold fs-5 text-dark">$<%= "%.2f" % (product.price_cents.to_i / 100.0) %></span>
          
          <%= button_to (max_reached ? "Maxed" : "Add"), 
                        cart_items_path(product_id: product.id), 
                        class: "btn btn-dark btn-sm rounded-pill px-3 fw-semibold", 
                        disabled: product.stock_quantity.to_i <= 0 || max_reached %>
        </div>

      </div>
    </div>
  <% end %>
</div>

