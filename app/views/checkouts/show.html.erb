<div class="text-center my-5">
  <h1 class="text-success">Thank You for Your Order!</h1>
  <p class="lead">Order #<%= @order.id %> has been placed successfully.</p>
</div>

<div class="card col-md-8 mx-auto">
  <div class="card-header d-flex justify-content-between">
    <span><strong>Order Status:</strong> <%= @order.status.titleize %></span>
    <span><%= @order.created_at.strftime("%B %d, %Y") %></span>
  </div>
  <div class="card-body">
    <h5>Items Ordered:</h5>
    <ul class="list-group list-group-flush mb-3">
      <% @order.order_items.each do |item| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= item.product.name %></strong>
            <small class="text-muted d-block">Qty: <%= item.quantity %></small>
          </div>
          <span>$<%= "%.2f" % ((item.quantity * item.unit_price_cents) / 100.0) %></span>
        </li>
      <% end %>
    </ul>
    <h4 class="text-end">Total Paid: $<%= "%.2f" % (@order.total_cents / 100.0) %></h4>
  </div>
</div>

<div class="text-center mt-4">
  <%= link_to "Continue Shopping", products_path, class: "btn btn-primary" %>
</div>