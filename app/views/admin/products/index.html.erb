
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Products</h1>
  <%= link_to "New Product", new_admin_product_path, class: "btn btn-success" %>
</div>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>Stock</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td>
          <% if product.images.attached? %>
            <%= image_tag product.images.first, width: 50 %>
          <% else %>
            No Image
          <% end %>
        </td>
        <td><%= product.name %></td>
        <td><%= product.category&.name %></td>
        <td>$<%= "%.2f" % (product.price_cents / 100.0) %></td>
        <td><%= product.stock_quantity %></td>
          <td>
            <%= link_to "View", admin_product_path(product), class: "btn btn-sm btn-info me-1" %>
            <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-sm btn-primary me-1" %>
            <%= button_to "Delete", admin_product_path(product), 
                          method: :delete, 
                          form: { data: { turbo_confirm: "Are you sure you want to delete this product?" } }, 
                          class: "btn btn-sm btn-danger d-inline" %>
          </td>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
