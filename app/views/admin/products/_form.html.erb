<%= form_with model: [:admin, product], local: true, multipart: true do |f| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger rounded-3 mb-4">
      <ul class="mb-0 ps-3">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Product Name", class: "form-label fw-semibold small text-secondary" %>
    <%= f.text_field :name, class: "form-control rounded-3 py-2", required: true %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= f.label :category_id, "Category", class: "form-label fw-semibold small text-secondary" %>
      <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "Select Category" }, { class: "form-select rounded-3 py-2", required: true } %>
    </div>
    <div class="col-md-4">
      <%= f.label :price_cents, "Price (in Cents)", class: "form-label fw-semibold small text-secondary" %>
      <%= f.number_field :price_cents, class: "form-control rounded-3 py-2", placeholder: "2999 = $29.99", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :stock_quantity, "Stock Quantity", class: "form-label fw-semibold small text-secondary" %>
      <%= f.number_field :stock_quantity, class: "form-control rounded-3 py-2", placeholder: "10", min: 0, required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description", class: "form-label fw-semibold small text-secondary" %>
    <%= f.text_area :description, rows: 4, class: "form-control rounded-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :images, "Product Gallery Images", class: "form-label fw-semibold small text-secondary" %>
    
    <% if product.images.attached? %>
      <div class="d-flex flex-wrap gap-2 mb-2">
        <% product.images.each do |img| %>
          <div class="position-relative">
            <%= image_tag img, class: "rounded-3 object-fit-cover border", size: "70x70" %>
          </div>
        <% end %>
      </div>
      <small class="text-muted d-block mb-2">Uploading new files will append them to the gallery.</small>
    <% end %>

    <%= f.file_field :images, multiple: true, class: "form-control rounded-3 py-2", accept: "image/png, image/jpeg, image/webp" %>
  </div>

  <div class="d-flex align-items-center gap-2">
    <%= f.submit product.new_record? ? "Create Product" : "Save Changes", class: "btn btn-dark rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
    <%= link_to "Cancel", admin_products_path, class: "btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" %>
  </div>
<% end %>