<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Product Details</h1>
  <div>
    <%= link_to "Edit Product", edit_admin_product_path(@product), class: "btn btn-primary me-2" %>
    <%= link_to "Back to Products", admin_products_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <div class="row">
      <div class="col-md-4">
        <% if @product.images.attached? %>
          <div class="d-flex flex-wrap gap-2">
            <% @product.images.each do |image| %>
              <%= image_tag image, class: "img-fluid rounded border mb-2", style: "max-height: 250px; object-fit: cover;" %>
            <% end %>
          </div>
        <% else %>
          <div class="p-4 bg-light text-center text-muted rounded">No images attached</div>
        <% end %>
      </div>

      <div class="col-md-8">
        <h2><%= @product.name %></h2>
        <p class="text-muted"><strong>Category:</strong> <%= @product.category&.name || "Uncategorized" %></p>
        <h3 class="text-success">$<%= "%.2f" % @product.price %></h3>
        
        <p><strong>Stock Quantity:</strong> <%= @product.stock_quantity %></p>
        <p>
          <strong>Status:</strong> 
          <% if @product.active? %>
            <span class="badge bg-success">Active</span>
          <% else %>
            <span class="badge bg-secondary">Inactive</span>
          <% end %>
        </p>

        <div class="mt-3">
          <h5>Description</h5>
          <p><%= @product.description.presence || "No description provided." %></p>
        </div>
      </div>
    </div>
  </div>
</div>