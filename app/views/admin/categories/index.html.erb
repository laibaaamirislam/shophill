<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Categories</h1>
  <%= link_to "New Category", new_admin_category_path, class: "btn btn-primary" %>
</div>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Name</th>
      <th>Slug</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
        <td><%= category.slug %></td>
          <td>
            <%= link_to "View", admin_category_path(category), class: "btn btn-sm btn-info me-1" %>
            <%= link_to "Edit", edit_admin_category_path(category), class: "btn btn-sm btn-secondary me-1" %>
            <%= button_to "Delete", admin_category_path(category), 
              method: :delete, 
              form: { data: { turbo_confirm: "Are you sure?" } }, 
              class: "btn btn-sm btn-danger d-inline" %>
          </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= will_paginate @categories %>