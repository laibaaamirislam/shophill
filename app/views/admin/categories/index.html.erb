<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="fw-bold text-dark m-0">Category Management</h3>
    <p class="text-secondary small m-0">Organize your store catalog into searchable groups</p>
  </div>
  <%= link_to "+ New Category", new_admin_category_path, class: "btn btn-dark rounded-pill px-4 fw-semibold" %>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
  <% if @categories.empty? %>
    <p class="text-muted text-center py-4 m-0">No categories created yet.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr class="text-secondary small text-uppercase">
            <th>Category Name</th>
            <th>Description</th>
            <th>Products Count</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="fw-bold text-dark"><%= category.name %></td>
              <td class="text-secondary small"><%= category.description.presence || "—" %></td>
              <td>
                <span class="badge bg-light text-dark rounded-pill border px-3 py-1">
                  <%= category.respond_to?(:products_count) ? category.products_count : category.products.count %> products
                </span>
              </td>
              <td class="text-end">
                <div class="d-flex align-items-center justify-content-end gap-2">
                  <%= link_to "Edit", edit_admin_category_path(category), class: "btn btn-sm btn-outline-dark rounded-pill px-3" %>
                 <%= button_to "Delete", admin_category_path(category), 
                      method: :delete, 
                      onclick: "return confirm('Are you sure you want to delete this category?');", 
                      class: "btn btn-sm btn-outline-danger rounded-pill px-3" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>