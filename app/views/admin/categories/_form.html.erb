<%= form_with model: [:admin, category], local: true do |f| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger rounded-3 mb-4">
      <ul class="mb-0 ps-3">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Category Name", class: "form-label fw-semibold small text-secondary" %>
    <%= f.text_field :name, class: "form-control rounded-3 py-2", placeholder: "e.g., Electronics, Footwear", required: true %>
  </div>

  <div class="mb-4">
    <%= f.label :description, "Description (Optional)", class: "form-label fw-semibold small text-secondary" %>
    <%= f.text_area :description, rows: 3, class: "form-control rounded-3 py-2", placeholder: "Brief description of the category..." %>
  </div>

  <div class="d-flex align-items-center gap-2">
    <%= f.submit category.new_record? ? "Create Category" : "Save Changes", class: "btn btn-dark rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
    <%= link_to "Cancel", admin_categories_path, class: "btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" %>
  </div>
<% end %>