<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="fw-bold text-dark m-0">Admin: Order #<%= @order.id %></h3>
    <span class="text-secondary small">Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
  </div>
  <div>
    <%= link_to "← Back to Orders", admin_orders_path, class: "btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold" %>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Order Items & Customer Details -->
  <div class="col-lg-7">
    <!-- Order Items -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
      <h5 class="fw-bold text-dark mb-3">Order Items</h5>
      <div class="d-flex flex-column gap-3">
        <% @order.order_items.each do |item| %>
          <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
            <div class="d-flex align-items-center gap-3">
              <div class="bg-light rounded-3 d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" style="width: 56px; height: 56px;">
                <% if item.product.respond_to?(:images) && item.product.images.attached? %>
                  <%= image_tag item.product.images.first, class: "w-100 h-100 object-fit-cover" %>
                <% elsif item.product.respond_to?(:image) && item.product.image.attached? %>
                  <%= image_tag item.product.image, class: "w-100 h-100 object-fit-cover" %>
                <% else %>
                  <span class="text-muted small">No Image</span>
                <% end %>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0"><%= item.product.name %></h6>
                <small class="text-muted">Qty: <%= item.quantity %> × $<%= "%.2f" % (item.unit_price_cents.to_i / 100.0) %></small>
              </div>
            </div>
            <span class="fw-bold text-dark">$<%= "%.2f" % ((item.unit_price_cents.to_i * item.quantity) / 100.0) %></span>
          </div>
        <% end %>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
        <span class="fw-bold text-dark fs-5">Total Amount</span>
        <span class="fw-bold text-dark fs-4">$<%= "%.2f" % (@order.total_cents.to_i / 100.0) %></span>
      </div>
    </div>

    <!-- Customer & Shipping Info -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
      <h5 class="fw-bold text-dark mb-3">Customer & Shipping Details</h5>
      <div class="row g-3">
        <div class="col-md-6">
          <span class="text-secondary small fw-semibold d-block">Customer Email</span>
          <p class="mb-0 text-dark fw-semibold"><%= @order.customer&.email || "Guest Customer" %></p>
        </div>
        <div class="col-md-6">
          <span class="text-secondary small fw-semibold d-block">Phone Number</span>
          <p class="mb-0 text-dark fw-semibold"><%= @order.phone %></p>
        </div>
        <div class="col-12">
          <span class="text-secondary small fw-semibold d-block">Shipping Address</span>
          <p class="mb-0 text-dark">
            <%= @order.shipping_address %><br>
            <%= @order.city %>, <%= @order.postal_code %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: Status Controls & Stripe Details -->
  <div class="col-lg-5">
    <!-- Fulfillment Status Management -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
      <h5 class="fw-bold text-dark mb-3">Fulfillment Status</h5>
      
      <%= form_with model: [:admin, @order], local: true do |f| %>
        <div class="mb-3">
          <%= f.label :status, "Update Status", class: "form-label text-secondary small fw-semibold" %>
          <%= f.select :status, [["Pending", "pending"], ["Paid", "paid"], ["Shipped", "shipped"], ["Completed", "completed"], ["Cancelled", "cancelled"]], {}, class: "form-select rounded-3 py-2" %>
        </div>
        <%= f.submit "Save Status", class: "btn btn-dark rounded-pill w-100 fw-semibold" %>
      <% end %>
    </div>

    <!-- Stripe Payment & Invoice Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
      <h5 class="fw-bold text-dark mb-3">Payment & Stripe Audit</h5>

      <% if @order.invoice %>
        <div class="bg-light rounded-3 p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary small">Invoice Status</span>
            <span class="badge bg-success rounded-pill px-2.5 py-1 text-uppercase small"><%= @order.invoice.status %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary small">Billed Email</span>
            <span class="fw-semibold text-dark small text-truncate" style="max-width: 170px;"><%= @order.invoice.customer_email %></span>
          </div>
          <% if @order.invoice.stripe_payment_intent_id.present? %>
            <div class="mb-2">
              <span class="text-secondary small d-block">Payment Intent ID</span>
              <span class="font-monospace text-dark small text-break"><%= @order.invoice.stripe_payment_intent_id %></span>
            </div>
          <% end %>
          <% if @order.invoice.stripe_checkout_session_id.present? %>
            <div>
              <span class="text-secondary small d-block">Checkout Session ID</span>
              <span class="font-monospace text-dark small text-break"><%= @order.invoice.stripe_checkout_session_id %></span>
            </div>
          <% end %>
        </div>
      <% elsif @order.stripe_session_id.present? %>
        <div class="bg-light rounded-3 p-3 mb-3">
          <span class="text-secondary small d-block">Checkout Session ID</span>
          <span class="font-monospace text-dark small text-break"><%= @order.stripe_session_id %></span>
        </div>
        <div class="alert alert-warning rounded-3 small mb-0">
          Stripe session attached, but no Invoice record exists yet.
        </div>
      <% else %>
        <div class="alert alert-secondary rounded-3 small mb-0">
          No Stripe transaction data associated with this order.
        </div>
      <% end %>
    </div>
  </div>
</div>