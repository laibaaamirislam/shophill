<h1>Your Cart</h1>

<% if @cart.cart_items.empty? %>
  <p>Your cart is empty. <%= link_to "Browse Products", products_path %></p>
<% else %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Total</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @cart.cart_items.each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <td>$<%= "%.2f" % item.product.price %></td>
          <td>
            <%= form_with model: item, url: cart_item_path(item), method: :patch, local: true, class: "d-flex gap-2 align-items-center" do |f| %>
              <%= f.number_field :quantity, value: item.quantity, min: 1, max: item.product.stock_quantity, class: "form-control w-auto" %>
              <%= f.submit "Update", class: "btn btn-sm btn-secondary" %>
            <% end %>
            <small class="text-muted d-block mt-1">(In stock: <%= item.product.stock_quantity %>)</small>
          </td>
          <td>$<%= "%.2f" % ((item.quantity * item.product.price_cents) / 100.0) %></td>
          <td>
            <%= button_to "Remove", cart_item_path(item), 
                          method: :delete, 
                          form: { data: { turbo_confirm: "Are you sure you want to remove this item?" } }, 
                          class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-between align-items-center mt-4">
    <h3>Total: $<%= "%.2f" % (@cart.total_cents / 100.0) %></h3>
    <%= link_to "Proceed to Checkout", new_checkout_path, class: "btn btn-success btn-lg" %>
  </div>
<% end %>