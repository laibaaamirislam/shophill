<div class="d-flex align-items-center justify-content-between mb-4">
  <h3 class="fw-bold text-dark m-0">Shopping Cart</h3>
  <% if @cart&.cart_items&.any? %>
    <span class="badge bg-dark-subtle text-dark rounded-pill px-3 py-2 fw-semibold">
      <%= @cart.cart_items.sum(:quantity) %> <%= "item".pluralize(@cart.cart_items.sum(:quantity)) %>
    </span>
  <% end %>
</div>

<% if @cart.nil? || @cart.cart_items.empty? %>
  <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
    <div class="fs-1 mb-2">🛒</div>
    <h5 class="fw-bold text-dark">Your cart is empty</h5>
    <p class="text-secondary small">Looks like you haven't added anything to your cart yet.</p>
    <div class="mt-2">
      <%= link_to "Explore Products", products_path, class: "btn btn-dark rounded-pill px-4 fw-semibold text-decoration-none" %>
    </div>
  </div>
<% else %>
  <div class="row g-4">
    <!-- Cart Items List -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4">
        <div class="d-flex flex-column gap-3">
          <% @cart.cart_items.each_with_index do |item, index| %>
            <div class="d-flex align-items-center justify-content-between py-2 <%= 'border-bottom' unless index == @cart.cart_items.size - 1 %>">
              
              <!-- Image & Title -->
              <div class="d-flex align-items-center gap-3" style="min-width: 220px;">
                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" style="width: 72px; height: 72px;">
                  <% if item.product.respond_to?(:images) && item.product.images.attached? %>
                    <%= image_tag item.product.images.first, class: "w-100 h-100 object-fit-cover" %>
                  <% elsif item.product.respond_to?(:image) && item.product.image.attached? %>
                    <%= image_tag item.product.image, class: "w-100 h-100 object-fit-cover" %>
                  <% else %>
                    <span class="text-muted small">No Image</span>
                  <% end %>
                </div>
                <div>
                  <h6 class="fw-bold text-dark mb-1 text-truncate" style="max-width: 180px;"><%= item.product.name %></h6>
                  <div class="text-secondary small">$<%= "%.2f" % (item.product.price_cents.to_i / 100.0) %> each</div>
                </div>
              </div>

              <!-- Inline Quantity Controls -->
              <div class="d-flex align-items-center bg-light rounded-pill border px-2 py-1">
                <%= button_to cart_item_path(item), 
                              method: :patch, 
                              params: { quantity: item.quantity - 1 }, 
                              class: "btn btn-sm text-dark text-decoration-none px-2 fw-bold border-0 shadow-none p-0",
                              form_class: "d-inline" do %>
                  <span class="fs-6">–</span>
                <% end %>

                <span class="fw-bold px-3 small"><%= item.quantity %></span>

                <%= button_to cart_item_path(item), 
                              method: :patch, 
                              params: { quantity: item.quantity + 1 }, 
                              disabled: item.quantity >= item.product.stock_quantity.to_i,
                              class: "btn btn-sm text-dark text-decoration-none px-2 fw-bold border-0 shadow-none p-0",
                              form_class: "d-inline" do %>
                  <span class="fs-6">+</span>
                <% end %>
              </div>

              <!-- Item Subtotal -->
              <div class="text-end fw-bold text-dark fs-6" style="min-width: 80px;">
                $<%= "%.2f" % ((item.product.price_cents.to_i * item.quantity) / 100.0) %>
              </div>

              <!-- Remove Item Button -->
              <div>
                <%= button_to cart_item_path(item), method: :delete, class: "btn btn-sm btn-light rounded-circle p-2 text-secondary d-flex align-items-center justify-content-center", style: "width: 32px; height: 32px;", data: { turbo_confirm: "Remove this item?" } do %>
                  ✕
                <% end %>
              </div>

            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 position-sticky" style="top: 20px;">
        <h5 class="fw-bold text-dark mb-4">Order Summary</h5>

        <% subtotal_cents = @cart.cart_items.sum { |i| i.product.price_cents.to_i * i.quantity } %>

        <div class="d-flex justify-content-between text-secondary mb-2 small">
          <span>Subtotal</span>
          <span class="fw-semibold text-dark">$<%= "%.2f" % (subtotal_cents / 100.0) %></span>
        </div>
        
        <div class="d-flex justify-content-between text-secondary mb-3 small">
          <span>Shipping</span>
          <span class="text-success fw-bold">Free</span>
        </div>

        <hr class="my-3 text-muted">

        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="fw-bold text-dark fs-5">Total</span>
          <span class="fw-bold text-dark fs-4">$<%= "%.2f" % (subtotal_cents / 100.0) %></span>
        </div>

        <%= link_to "Proceed to Checkout", new_checkout_path, class: "btn btn-dark rounded-pill w-100 py-2.5 fw-semibold shadow-sm" %>
        
        <div class="text-center mt-3">
          <%= link_to "← Continue Shopping", products_path, class: "text-secondary small text-decoration-none fw-semibold" %>
        </div>
      </div>
    </div>
  </div>
<% end %>