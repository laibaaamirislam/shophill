<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Order #<%= @order.id %></h1>
  <%= link_to "Back to Orders", orders_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between">
    <span><strong>Status:</strong> <%= @order.status.titleize %></span>
    <span>Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
  </div>
  <div class="card-body">
    <h5>Items</h5>
    <ul class="list-group list-group-flush mb-3">
      <% @order.order_items.each do |item| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= item.product.name %></strong>
            <small class="text-muted d-block">Qty: <%= item.quantity %></small>
          </div>
          <span>$<%= "%.2f" % ((item.quantity * item.unit_price_cents) / 100.0) %></span>
        </li>
      <% end %>
    </ul>
    <h4 class="text-end">Total: $<%= "%.2f" % (@order.total_cents / 100.0) %></h4>
  </div>
</div>