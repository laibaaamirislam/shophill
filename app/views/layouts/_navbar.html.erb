<nav class="navbar navbar-expand-lg bg-white border-bottom py-3 mb-4">
  <div class="container">
    <%= link_to "Shophill", root_path, class: "navbar-brand fw-bold fs-4 text-dark me-4" %>

    <div class="d-flex flex-grow-1 me-4">
      <%= form_with url: products_path, method: :get, local: true, class: "w-100" do |f| %>
        <% if params[:category_id].present? %>
          <%= f.hidden_field :category_id, value: params[:category_id] %>
        <% end %>
        <%= f.text_field :query, value: params[:query], placeholder: "Search products...", class: "form-control bg-light border-0 rounded-pill px-4" %>
      <% end %>
    </div>

    <div class="d-flex align-items-center gap-3">
      <% if Current.customer %>

      <!-- Cart Lnk -->
        <%= link_to cart_path, class: "btn btn-outline-dark rounded-pill position-relative px-3" do %>
          🛒 Cart
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            <%= Current.customer.cart&.cart_items&.sum(:quantity) || 0 %>
          </span>
        <% end %>

        <!-- Orders Link -->
        <%= link_to "My Orders", orders_path, class: "btn btn-outline-dark rounded-pill position-relative px-3" %>

        <!-- Profile Link -->
        <%= link_to profile_path, class: "btn btn-outline-dark rounded-pill position-relative px-3" do %>
          My Profile
        <% end %>

        <!-- Logout Link -->
        <%= button_to "Logout", session_path, method: :delete, class: "btn btn-link text-secondary text-decoration-none p-0 small" %>
      <% else %>
        <%= link_to "Sign In", new_session_path, class: "btn btn-outline-dark rounded-pill px-3 py-1 fw-semibold small" %>
        <%= link_to "Sign Up", register_path, class: "btn btn-dark rounded-pill px-3 py-1 fw-semibold small" %>
      <% end %>

    </div>
  </div>
</nav>
