<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <%= link_to "Shophill", root_path, class: "navbar-brand fw-bold" %>
    
    <div class="collapse navbar-collapse">
      <ul class="navbar-brand navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to "Products", products_path, class: "nav-link" %>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto align-items-center gap-2">
        <% if Current.customer %>
          <li class="nav-item">
            <%= link_to "Cart (#{(Current.customer.cart&.cart_items&.sum(:quantity) || 0)})", cart_path, class: "btn btn-outline-light btn-sm" %>
          </li>
          <li class="nav-item">
            <%= link_to "My Orders", orders_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-sm btn-link nav-link d-inline" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Log In", login_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Register", register_path, class: "btn btn-primary btn-sm" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>