
<!DOCTYPE html>
<html>
  <head>
    <title>Admin Dashboard - Shophill</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body class="bg-light">
    <!-- Admin Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 mb-4">
      <div class="container">
        <%= link_to "Shophill Admin", admin_root_path, class: "navbar-brand fw-bold fs-4" %>
        
        <div class="d-flex align-items-center gap-3">
          <%= link_to "Dashboard", admin_root_path, class: "nav-link text-white small fw-semibold" %>
          <%= link_to "Products", admin_products_path, class: "nav-link text-white-50 small fw-semibold" %>
          <%= link_to "Categories", admin_categories_path, class: "nav-link text-white-50 small fw-semibold" %>
          <%= link_to "Orders", admin_orders_path, class: "nav-link text-white-50 small fw-semibold" %>
        </div>
      </div>
    </nav>

    <main class="container mb-5">
      <% if notice %>
        <div class="alert alert-success rounded-3 mb-4"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger rounded-3 mb-4"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>