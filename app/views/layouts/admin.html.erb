<!DOCTYPE html>
<html>
  <head>
    <title>Admin Dashboard - Shophill</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-dark bg-dark px-3 mb-4">
      <a class="navbar-brand" href="/admin/products">Admin Panel</a>
      <% if Current.admin %>
        <div>
          <span class="text-white me-3"><%= Current.admin.email %></span>
          <%= button_to "Logout", admin_session_path, method: :delete, class: "btn btn-outline-light btn-sm d-inline" %>
        </div>
      <% end %>
    </nav>

    <div class="container">
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>