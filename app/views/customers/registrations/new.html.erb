<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 my-4">
      <h3 class="fw-bold text-dark text-center mb-1">Create an Account</h3>
      <p class="text-secondary text-center small mb-4">Join Shophill to track orders and save preferences</p>

      <%= form_with model: @customer, url: register_path, local: true do |f| %>
        <% if @customer.errors.any? %>
          <div class="alert alert-danger rounded-3 mb-4">
            <ul class="mb-0 ps-3">
              <% @customer.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "Full Name", class: "form-label fw-semibold small text-secondary" %>
          <%= f.text_field :name, class: "form-control rounded-3 py-2", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "Email Address", class: "form-label fw-semibold small text-secondary" %>
          <%= f.email_field :email, class: "form-control rounded-3 py-2", required: true %>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <%= f.label :password, class: "form-label fw-semibold small text-secondary" %>
            <%= f.password_field :password, class: "form-control rounded-3 py-2", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-semibold small text-secondary" %>
            <%= f.password_field :password_confirmation, class: "form-control rounded-3 py-2", required: true %>
          </div>
        </div>

        <%= f.submit "Create Account", class: "btn btn-dark rounded-pill w-100 py-2.5 fw-semibold shadow-sm mb-3" %>
      <% end %>

      <div class="text-center small text-secondary">
        Already have an account? <%= link_to "Sign In", new_session_path, class: "text-dark fw-bold text-decoration-none" %>
      </div>
    </div>
  </div>
</div>