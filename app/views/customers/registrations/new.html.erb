<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-center mb-4">Customer Registration</h2>

        <%= form_with model: @customer, url: register_path, local: true do |f| %>
          <% if @customer.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @customer.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true, autofocus: true %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", required: true %>
          </div>

          <%= f.submit "Register Account", class: "btn btn-primary w-100" %>
        <% end %>

        <div class="mt-3 text-center">
          <%= link_to "Already have an account? Log in", login_path %>
        </div>
      </div>
    </div>
  </div>
</div>