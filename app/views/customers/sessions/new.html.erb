<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-center mb-4">Customer Login</h2>

        <%= form_with url: session_path, scope: :session, data: { turbo: false }, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true, autofocus: true %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>

          <%= f.submit "Log In", class: "btn btn-primary w-100" %>
        <% end %>

        <div class="mt-3 text-center">
          <%= link_to "Don't have an account? Register", register_path %>
        </div>
      </div>
    </div>
  </div>
</div>